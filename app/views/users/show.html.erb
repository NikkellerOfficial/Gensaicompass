
<div class="left-section">
  <div class="profile">
    <p class="home">おかえりなさい</p>
    <p class="username"><%= @user.name %>  さん</p>
    <p class="email"><%= @user.email %></p>
    <p class="sentence"><%= @user.profile %></p>

    <% if current_user.id == @user.id %>
      <%= button_to "ユーザー情報の更新", edit_user_registration_path,method: :get, class: "btn-shindan" %>
    <% end %>
  </div>


  <div class="diagnosis-container">
    <%= button_to "診断を始める", new_perfume_path,method: :get, class: "btn-shindan" %>
  </div>

  <div class="search-form-container">
    <h3>購入場所絞り込み</h3>
    <%= form_tag({controller: "users", action: "show"}, method: :get) do %>
      <%= select_tag :search,
            options_for_select(['スーパー', 'コンビニ','ホームセンター', 'ドラッグストア','デパート','その他'], params[:search]),
            include_blank: 'すべて',class: 'custom-select' %>
      <%= submit_tag '絞り込む',class: 'btn-shindan' %>
    <% end %>
  </div>
</div>

<div class="guide-section">


  <div class="sentence">

  </div>

</div>

<div class="user-title">
  <h2 class="itemtitle">あなたの防災アイテム</h2>
