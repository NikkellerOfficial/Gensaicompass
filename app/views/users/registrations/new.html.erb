<div class="login-container">

  <div class="title-section">
        <p class="sub-title">備えこそ、唯一の<span class="highlight">希望</span>。</p>
        <h1 class="main-title">GENSAI COMPASS</h1>
        <p class="sub-title">新規アカウント登録ページ</p>
  </div>

  <div class="login-form">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      
      <div class="field-group">
        <label class="input-label">新規ユーザー名</label>
        <%= f.text_field :name, autofocus: true,class: "form-input" %>
      </div>

      <div class="field-group">
        <label class="input-label">メールアドレス</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",class: "form-input" %>
      </div>

      <div class="field-group">
        <%= f.label :新規パスワード %>
        <% if @minimum_password_length %>
        <p>(半角英数字を<%= @minimum_password_length %> 文字以上入力してください。)</p>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "new-password",class: "form-input" %>
      </div>

      <div class="field-group">
        <%= f.label :新規パスワード確認用 %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password",class: "form-input" %>
      </div>

      <div class="actions">
        <%= f.submit "登録する", class: "btn-submit"%>
      </div>
    <% end %>

    <div class="shared-links">
    <%= render "users/shared/links" %>
    </div>
  </div>
</div>
